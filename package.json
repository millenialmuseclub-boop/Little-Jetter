{
  "name": "little-jetter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "generate:tokyo": "tsx scripts/generate-destination.ts tokyo"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@capawesome/capacitor-live-update": "^8.4.2",
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^3.2.29",
    "dotenv": "^16.6.1",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.13"
  }
}
